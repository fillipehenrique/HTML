<!DOCTYPE html>
<html>
  <head>
    <title>Calculadora</title>
  </head>
  <body>
    <form>
      <label>Valor A</label> <input type="number" id="v1"/>
      <label>Valor B</label> <input type="number" id="v2"/>
      <label>Operação</label>
      <select id="oper">
        <option>Soma</option> <option>Subtração</option>
        <option>Multiplicação</option> <option>Divisão</option>
        <option>Potência</option> 
      </select>
      <a href="#" onclick="executar()">Executar</a>
    </form>
    <div id="resp">O resultado aparece aqui</div>
    <script src="ROT_MOD1-NC3.js"></script>
    <script>
      const executar = () => {
        const a = eval(document.getElementByld("v1".value));
        const b = eval(document.getElementByld("v2".value));
        let oper = eval(document.getElementByld("oper").selectedIndex);
        let resultado = (oper==0)?somar(a,b): (oper==3)?dividir(a,b): exponencial(a,b);
        document.getElementByld("resp").innerHTML = 
        'O resultado da operação é ${resultado}';
      }
    </script>
  </body>
</html>
